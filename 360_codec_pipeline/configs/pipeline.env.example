# Copy this file (for example to configs/pipeline.env) and set all values that
# apply to your experiment. Blank values are deliberately NOT defaults.

# TO BE PROVIDED BY USER: regular ERP grid layout.
TILE_ROWS=
TILE_COLS=

# TO BE PROVIDED BY USER: number of entries should agree with each QP list.
NUM_QUALITIES=
H264_QPS=
HEVC_QPS=

# TO BE PROVIDED BY USER: optional alternative rate-control inputs.
H264_BITRATES=
HEVC_BITRATES=

# TO BE PROVIDED BY USER: encoding and segmentation settings.
GOP_SIZE=
FRAGMENT_DURATION=
H264_PRESET=
HEVC_PRESET=
H264_RC=
HEVC_RC=
B_FRAMES=

# Optional input and implementation choices; leave blank to pass explicitly.
INPUT_VIDEO=
H264_ENCODER=nvenc
HEVC_ENCODER=nvenc

# Examples only — do not uncomment as research defaults:
# TILE_ROWS=2
# TILE_COLS=4
# H264_QPS="22 27 32"
# HEVC_QPS="22 27 32"
# NUM_QUALITIES=3
